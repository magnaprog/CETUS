  },
  "projection_rules": [
    {
      "operation": "Replace with documentation-only identity and status; original executable status is not retained.",
      "source": "/schema,/status",
      "target": "/schema,/status"
    },
    {
      "operation": "Keep commit and script bytes/hash; drop checkout path; replace script path with source.consumer resource.",
      "source": "/consumer",
      "target": "/view/consumer"
    },
    {
      "operation": "Keep bytes and sha256 exactly; replace path with a declared logical resource.",
      "source": "/helper,/catalog,/protocol,/tiles,/weights,/python",
      "target": "/view/<same key>"
    },
    {
      "operation": "Keep commit; drop checkout path; replace file paths with separately hashed full relative-path inventory.",
      "source": "/historical_source",
      "target": "/view/historical_source"
    },
    {
      "operation": "Keep commit and file names/bytes/hashes; drop root path; replace file paths with upstream/<file> resources.",
      "source": "/upstream",
      "target": "/view/upstream"
    },
    {
      "operation": "Keep order, fold, counts and each binding's bytes/hash; bound paths become fold/<fold>/<key>; features_dir becomes features_resource.",
      "source": "/folds/*",
      "target": "/view/folds/*"
    },
    {
      "operation": "Keep order and cell/fold/seed/band/device unchanged; output and replay_output become cell/<two-digit cell>/fit and cell/<two-digit cell>/replay resources.",
      "source": "/cells/*",
      "target": "/view/cells/*"
    },
    {
      "operation": "Preserve array index only; replace physical UUID and lock path by device/<index> and lock/<index> resources.",
      "source": "/devices/*",
      "target": "/view/devices/*"
    },
    {
      "operation": "Replace host paths with output.root and runtime.python_entrypoint resources.",
      "source": "/output_root,/python_entrypoint",
      "target": "/view/output_resource,/view/python_entrypoint_resource"
    },
    {
      "operation": "Copy values unchanged.",
      "source": "/policy,/initial_feature_state,/head_state_sha256,/fit_timeout_seconds,/replay_timeout_seconds",
      "target": "/view/<same key>"
    },
    {
      "operation": "Add unchanged class order from supplied historical protocol.",
      "source": "Historical protocol /specification/class_names",
      "target": "/view/class_names"
    }
  ],
