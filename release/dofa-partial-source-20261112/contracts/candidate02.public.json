{
  "limits": [
    "Logical resources are not filesystem bindings and cannot be submitted to the original runner.",
    "The original contract hash identifies an omitted original, not these projected bytes.",
    "Physical devices, host layout and runtime entrypoint are not reconstructible from this view.",
    "No inputs, outputs, checkpoints, launch approval or scientific acceptance are supplied."
  ],
